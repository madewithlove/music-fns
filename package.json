{
  "name": "music-fns",
  "version": "0.1.3",
  "description": "JavaScript music utility library that contains small music notation related functions.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madewithlove/music-fns.git"
  },
  "keywords": [
    "music",
    "utility",
    "audio"
  ],
  "author": "",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/madewithlove/music-fns/issues"
  },
  "homepage": "https://github.com/madewithlove/music-fns#readme",
  "source": "src/index.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "require": "./dist/index.js",
    "default": "./dist/index.modern.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "unpkg": "./dist/index.umd.js",
  "umd:main": "./dist/index.umd.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "microbundle",
    "dev": "microbundle watch",
    "test:watch": "vitest watch",
    "test": "vitest --run",
    "format": "prettier --write . --log-level error",
    "format:check": "prettier --check . --log-level error",
    "lint": "eslint src/",
    "check": "npm-run-all -l --parallel format lint test types:check",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "eslint": "^9.25.1",
    "globals": "^16.0.0",
    "microbundle": "^0.15.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.2"
  }
}
